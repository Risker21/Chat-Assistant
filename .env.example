# ==========================================
# 解忧小铺 · AI 智能助手 环境变量配置模板
# 复制本文件为 .env 并填入你已开通的 API Key
# （支持按需配置，只需配置至少一个模型即可启动）
# ==========================================

# 应用基础配置
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# 数据持久化（默认使用本地 SQLite: sqlite:///./data/chat_assistant.db）
# 生产环境可替换为 PostgreSQL: postgresql://user:pass@host:5432/dbname
# DATABASE_URL=sqlite:///./data/chat_assistant.db

# 安全与限流（生产环境务必设置强随机密钥）
JWT_SECRET_KEY=please-change-this-to-a-long-random-secret
JWT_EXPIRE_MINUTES=10080
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# 默认模型与上下文
DEFAULT_MODEL=deepseek
MAX_HISTORY_MESSAGES=20
REQUEST_TIMEOUT_SECONDS=90

# 1. DeepSeek (Zoe · 暖心搭子)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 2. 阿里百炼 / 通义千问 & 万相绘图 & 视觉理解 (Luna · 疗愈情感)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-max
WANX_IMAGE_MODEL=wanx-v1

# 3. 腾讯混元 (Ethan · 博学专家)
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hunyuan-turbos-latest

# 4. 智谱 GLM (Felix · 算卦大师)
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5

# 5. 字节豆包 / 火山方舟 (小Y · 绘画大师)
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-8-251228
DOUBAO_IMAGE_MODEL=doubao-seedream-5-0-260128

# 6. Tavily 联网搜索（可选，配置后自动启用实时联网搜索与引用来源）
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_RESULTS=5
